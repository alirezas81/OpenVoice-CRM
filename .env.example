# Primary RAG / chat provider: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_PROVIDER=anthropic
# Choose claude-3-5-sonnet-20241022 (default) or claude-3-5-haiku-20241022
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq powers Whisper STT in the current MVP; it can also be selected as the LLM provider.
GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# STT language code and Edge TTS voice are configurable.
STT_LANGUAGE=en
# Edge TTS provides voices across 40+ languages/locales. Examples: en-US-AriaNeural, en-US-GuyNeural.
EDGE_TTS_VOICE=en-US-AriaNeural

# Local knowledge base and vector index paths
KNOWLEDGE_BASE_PATH=data/knowledge_base.txt
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# Audio settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
VAD_STOP_SECS=0.65
VAD_CONFIDENCE=0.65

# Optional: host audio group ID for Linux Docker Compose access to /dev/snd.
# AUDIO_GID=29
